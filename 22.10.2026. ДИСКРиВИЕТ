import math

def solve_discriminant(a, b, c):
    """Решение через дискриминант (альтернативный стиль)"""
    print(f"\n--- Метод Дискриминанта ---")
    D = b**2 - 4*a*c
    print(f"Дискриминант D = {D}")

    if D < 0:
        print("Уравнение не имеет действительных корней.")
    elif D == 0:
        root = -b / (2 * a)
        print(f"Уравнение имеет один корень: x = {root}")
    else:
        # Используем math.sqrt для красоты
        sqrt_D = math.sqrt(D)
        x1 = (-b + sqrt_D) / (2 * a)
        x2 = (-b - sqrt_D) / (2 * a)
        print(f"Уравнение имеет два корня:\n x1 = {x1}\n x2 = {x2}")

def solve_vieta(a, b, c):
    """Решение через теорему Виета (оптимизированный перебор)"""
    print(f"\n--- Метод Виета ---")
    
    # Приводим уравнение к виду x^2 + px + q = 0 (делим на a)
    # Это делает теорему Виета универсальной
    if a == 0:
        print("Ошибка: a не может быть 0.")
        return

    p = b / a
    q = c / a
    
    print(f"Приведенное уравнение: x^2 + ({p})x + ({q}) = 0")
    print("Ищем корни, где x1 + x2 = -p, а x1 * x2 = q...")

    # Перебор делителей свободного члена (если q целое)
    # Это работает быстрее, чем перебор всех чисел от -1000 до 1000
    if q == int(q):
        q = int(q)
        # Ищем делители числа q
        for i in range(1, abs(q) + 1):
            if q % i == 0:
                # Проверяем пару (i, q//i) и (-i, -q//i)
                for x1, x2 in [(i, q//i), (-i, -q//i)]:
                    if x1 + x2 == -p:
                        print(f"Найдены корни: x1 = {x1}, x2 = {x2}")
                        return
        print("Целых корней не найдено (возможно, корни дробные или иррациональные).")
    else:
        print("Коэффициенты не целые, метод подбора Виета может не сработать.")

def main():
    print("=== Решатель квадратных уравнений (Вариант 2) ===")
    
    while True:
        try:
            print("\nВведите коэффициенты:")
            a = float(input("a = "))
            b = float(input("b = "))
            c = float(input("c = "))
        except ValueError:
            print("Ошибка: введите числа!")
            continue

        print("\nВыберите метод:")
        print("1. Через Дискриминант")
        print("2. Через Теорему Виета")
        print("0. Выход")
        
        choice = input("Ваш выбор: ")

        if choice == '1':
            solve_discriminant(a, b, c)
        elif choice == '2':
            solve_vieta(a, b, c)
        elif choice == '0':
            print("До свидания!")
            break
        else:
            print("Неверный ввод, попробуйте снова.")

# Запуск программы
if __name__ == "__main__":
    main()
